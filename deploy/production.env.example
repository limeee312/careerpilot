# Copy to .env.production in the repository root; replace all placeholders.
# APP_DOMAIN is a DNS hostname, without https:// or a trailing slash.
APP_DOMAIN=careerpilot.example.com
BASIC_AUTH_USER=demo
# Generate with: docker run -it --rm caddy:2-alpine caddy hash-password
# Put the hash in single quotes so Compose does not interpolate its dollar signs.
BASIC_AUTH_HASH='REPLACE_WITH_CADDY_PASSWORD_HASH'
POSTGRES_DB=careerpilot
POSTGRES_USER=careerpilot
# Generate a URL-safe secret with: python -c 'import secrets; print(secrets.token_hex(32))'
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
JWT_SECRET=REPLACE_WITH_A_DIFFERENT_64_HEX_SECRET
JWT_EXPIRE_MINUTES=60
OPENAI_API_KEY=REPLACE_WITH_SERVER_SIDE_KEY
OPENAI_MODEL=REPLACE_WITH_SUPPORTED_MODEL
OPENAI_TIMEOUT_SECONDS=30
RELEASE_TAG=local
