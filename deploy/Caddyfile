{$APP_DOMAIN} {
    encode zstd gzip

    # Private demonstration gate; use hashed credentials from the environment.
    basic_auth {
        {$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
    }

    @api path /api/v1 /api/v1/* /health
    handle @api {
        reverse_proxy backend:8000 {
            header_up -Authorization
        }
    }

    handle {
        reverse_proxy frontend:3000 {
            header_up -Authorization
        }
    }
}
